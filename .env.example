# ============================================
# 环境变量配置示例
# ============================================
# 使用方法：
# 1. 复制此文件并重命名为 .env
# 2. 修改下面的配置值
# 3. .env 文件不会被提交到 Git（已在 .gitignore 中排除）
# ============================================

# Flask 密钥（用于加密，请改成随机字符串）
SECRET_KEY=your-secret-key-change-me

# JWT 密钥（用于用户登录 Token）
JWT_SECRET_KEY=jwt-secret-key-change-me

# 数据库连接
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/community_repair

# 微信小程序配置
# 在微信公众平台(mp.weixin.qq.com)注册小程序后获取
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
