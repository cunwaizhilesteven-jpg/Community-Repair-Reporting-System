/**
 * 数据导出页面样式
 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 30rpx 120rpx;
}

/* 头部卡片 */
.header-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.header-icon {
  font-size: 60rpx;
  margin-right: 24rpx;
}

.header-info {
  flex: 1;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  display: block;
}

/* 配置区域 */
.config-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 快捷选择 */
.quick-select {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.quick-btn:active {
  background: #e6f7ff;
  color: #1890ff;
}

/* 日期选择 */
.date-row {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.date-item {
  flex: 1;
}

.date-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
}

.date-value {
  font-size: 28rpx;
  color: #333;
}

.date-icon {
  font-size: 28rpx;
}

.date-divider {
  padding: 0 20rpx;
  color: #999;
  margin-top: 30rpx;
}

/* 状态筛选 */
.filter-item {
  /* 筛选项 */
}

.filter-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.filter-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

/* 说明区域 */
.tips-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.tips-content {
  /* 提示内容 */
}

.tip-item {
  display: flex;
  margin-bottom: 12rpx;
}

.tip-icon {
  color: #1890ff;
  margin-right: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}

/* 操作按钮 */
.action-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.btn-secondary,
.btn-primary {
  flex: 1;
  text-align: center;
  padding: 28rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-secondary {
  background: #fff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
}

.btn-primary {
  background: #1890ff;
  color: #fff;
}

.btn-primary.disabled {
  background: #ccc;
}

/* 导出历史 */
.history-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.history-list {
  /* 历史列表 */
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-info {
  /* 历史信息 */
}

.history-date {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.history-status {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.history-time {
  font-size: 24rpx;
  color: #999;
}
