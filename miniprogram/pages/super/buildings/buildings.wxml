<!--
  楼栋管理页面
  超级管理员管理小区楼栋
-->
<view class="container">
  <!-- 添加按钮 -->
  <view class="add-btn" bindtap="showAddModal">
    <text class="add-icon">+</text>
    <text>添加楼栋</text>
  </view>

  <!-- 楼栋列表 -->
  <view class="building-list">
    <view
      class="building-card"
      wx:for="{{buildings}}"
      wx:key="id"
    >
      <view class="building-info" bindtap="editBuilding" data-building="{{item}}">
        <view class="building-icon">
          <text class="icon-text">楼</text>
        </view>
        <view class="building-detail">
          <view class="building-name">{{item.name}}</view>
          <view class="building-meta">
            <text class="meta-item">{{item.units}}个单元</text>
            <text class="meta-divider">|</text>
            <text class="meta-item">{{item.floors}}层</text>
          </view>
        </view>
      </view>
      <view class="building-actions">
        <view class="action-btn edit" bindtap="editBuilding" data-building="{{item}}">
          编辑
        </view>
        <view class="action-btn delete" bindtap="deleteBuilding" data-building="{{item}}">
          删除
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{buildings.length === 0 && !loading}}">
      <view class="empty-icon">🏢</view>
      <text class="empty-text">暂无楼栋数据</text>
      <text class="empty-hint">点击上方按钮添加楼栋</text>
    </view>

    <!-- 加载中 -->
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="closeModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">{{isNew ? '添加楼栋' : '编辑楼栋'}}</text>
        <text class="modal-close" bindtap="closeModal">×</text>
      </view>

      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">楼栋名称</text>
          <input
            class="form-input"
            placeholder="如：1栋、A栋"
            value="{{formData.name}}"
            bindinput="onNameInput"
          />
        </view>

        <view class="form-item">
          <text class="form-label">单元数量</text>
          <input
            class="form-input"
            type="number"
            placeholder="请输入单元数量"
            value="{{formData.units}}"
            bindinput="onUnitsInput"
          />
        </view>

        <view class="form-item">
          <text class="form-label">楼层数</text>
          <input
            class="form-input"
            type="number"
            placeholder="请输入楼层数"
            value="{{formData.floors}}"
            bindinput="onFloorsInput"
          />
        </view>
      </view>

      <view class="modal-footer">
        <view class="btn-cancel" bindtap="closeModal">取消</view>
        <view class="btn-confirm" bindtap="saveBuilding">保存</view>
      </view>
    </view>
  </view>
</view>
