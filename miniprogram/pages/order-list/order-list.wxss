/**
 * 工单列表页面样式
 */

/* 状态筛选标签 */
.status-tabs {
  display: flex;
  white-space: nowrap;
  background-color: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.status-tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background-color: #f5f5f5;
  font-size: 26rpx;
  color: #666;
}

.status-tab.active {
  background-color: #1890ff;
  color: #fff;
}

/* 工单卡片 */
.order-card {
  margin-bottom: 16rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 26rpx;
  color: #666;
}

.order-content {
  margin-bottom: 16rpx;
}

.order-category {
  display: inline-block;
  padding: 4rpx 12rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  font-size: 24rpx;
  color: #666;
}

.order-desc {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-top: 12rpx;
  line-height: 1.5;
}

.order-location {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.location-icon {
  margin-right: 8rpx;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-arrow {
  color: #ccc;
}

/* 加载状态 */
.load-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}
