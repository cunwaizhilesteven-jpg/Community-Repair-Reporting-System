<view class="container" wx:if="{{!loading && order}}">
  <view class="status-card card">
    <text class="status-tag status-{{order.status}} large">{{order.status_name}}</text>
    <text class="order-no">{{order.order_no}}</text>
  </view>
  <view class="info-card card">
    <view class="card-title">报修信息</view>
    <view class="info-row"><text class="info-label">类别</text><text class="info-value">{{order.category.name}}</text></view>
    <view class="info-row"><text class="info-label">位置</text><text class="info-value">{{order.building.name || ''}} {{order.unit || ''}} {{order.room || ''}} {{order.location_desc || ''}}</text></view>
    <view class="info-row"><text class="info-label">描述</text><text class="info-value desc">{{order.description}}</text></view>
    <view class="info-row" bindtap="callPhone"><text class="info-label">电话</text><text class="info-value phone">{{order.contact_phone}} 📞</text></view>
  </view>
  <view class="action-area">
    <button class="btn btn-primary btn-block" wx:if="{{order.status === 'assigned'}}" bindtap="startOrder">开始处理</button>
    <button class="btn btn-primary btn-block" wx:if="{{order.status === 'processing'}}" bindtap="goToComplete">完成维修</button>
  </view>
</view>
<view class="loading" wx:if="{{loading}}"><text>加载中...</text></view>
