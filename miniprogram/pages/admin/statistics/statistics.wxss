.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #f0f0f0; }
.stat-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.stat-row:last-child { border-bottom: none; }
.stat-value { font-weight: 600; color: #1890ff; }
.stat-value.rating { color: #faad14; }
