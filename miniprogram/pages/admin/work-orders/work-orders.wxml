<view class="container">
  <scroll-view class="status-tabs" scroll-x>
    <view class="status-tab {{currentStatus === 'pending' ? 'active' : ''}}" bindtap="onStatusChange" data-status="pending">待审核</view>
    <view class="status-tab {{currentStatus === 'assigned' ? 'active' : ''}}" bindtap="onStatusChange" data-status="assigned">已分配</view>
    <view class="status-tab {{currentStatus === 'processing' ? 'active' : ''}}" bindtap="onStatusChange" data-status="processing">处理中</view>
    <view class="status-tab {{currentStatus === 'completed' ? 'active' : ''}}" bindtap="onStatusChange" data-status="completed">已完成</view>
  </scroll-view>
  <view class="order-card card" wx:for="{{orders}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
    <view class="order-header"><text>{{item.order_no}}</text><text class="status-tag status-{{item.status}}">{{item.status_name}}</text></view>
    <view class="order-content"><text class="order-category">{{item.category.name}}</text><text class="order-desc text-ellipsis">{{item.description}}</text></view>
    <view class="order-footer"><text>{{item.created_at}}</text><text>></text></view>
  </view>
  <view class="loading" wx:if="{{loading}}"><text>加载中...</text></view>
  <view class="empty-state" wx:if="{{!loading && orders.length === 0}}"><text>暂无工单</text></view>
</view>
