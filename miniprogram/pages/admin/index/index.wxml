<view class="container">
  <view class="stats-card card">
    <view class="stat-item"><text class="stat-num">{{stats.pending}}</text><text class="stat-label">待审核</text></view>
    <view class="stat-item"><text class="stat-num">{{stats.today}}</text><text class="stat-label">总工单</text></view>
    <view class="stat-item"><text class="stat-num">{{stats.completed}}</text><text class="stat-label">已完成</text></view>
  </view>
  <view class="menu-list">
    <view class="menu-item card" bindtap="goTo" data-url="/pages/admin/work-orders/work-orders">
      <text class="menu-icon">📋</text><text class="menu-title">工单管理</text><text class="menu-arrow">></text>
    </view>
    <view class="menu-item card" bindtap="goTo" data-url="/pages/admin/categories/categories">
      <text class="menu-icon">🏷️</text><text class="menu-title">类别管理</text><text class="menu-arrow">></text>
    </view>
    <view class="menu-item card" bindtap="goTo" data-url="/pages/admin/statistics/statistics">
      <text class="menu-icon">📊</text><text class="menu-title">统计报表</text><text class="menu-arrow">></text>
    </view>
  </view>
</view>
