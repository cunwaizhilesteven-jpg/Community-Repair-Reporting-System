/**
 * 评价页面样式
 */

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.rating-area {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.star {
  font-size: 64rpx;
  color: #ddd;
  margin: 0 16rpx;
  transition: all 0.2s;
}

.star.active {
  color: #faad14;
  transform: scale(1.1);
}

.rating-text {
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.submit-area {
  margin-top: 40rpx;
}
